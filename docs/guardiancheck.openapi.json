  "components": {
    "schemas": {
      "Guard": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "employeeNumber",
          "accountActive",
          "external",
          "assignedSiteIds",
          "expectedStartTime",
          "toleranceMinutes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "employeeNumber": {
            "type": "string",
            "nullable": true
          },
          "accountActive": {
            "type": "boolean"
          },
          "external": {
            "type": "boolean"
          },
          "assignedSiteIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedStartTime": {
            "type": "string",
            "nullable": true
          },
          "toleranceMinutes": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "Site": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Shift": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
