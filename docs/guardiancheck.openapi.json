{
  "openapi": "3.0.3",
  "info": {
    "title": "Guardian Check read API",
    "version": "1.0.0",
    "description": "Read-only operational API. Server credentials or explicitly authorized existing Firebase users. Browser CORS allowlist is not authentication. Follow nextCursor even after an empty page. Read queries are not a transactional snapshot. Details use ID and authorization, not the list default period."
  },
  "servers": [
    {
      "url": "https://us-central1-guardiancheck-prod.cloudfunctions.net/integrationApi",
      "description": "Production, deployed September 30, 2026. Explicit integration authorization required."
    },
    {
      "url": "http://127.0.0.1:5001/demo-guardiancheck-api/us-central1/integrationApi",
      "description": "Local demo emulator. For staging/production use the deployed integrationApi URL."
    }
  ],
